#!/bin/sh
# ===== routeur_apintus-2 : VTEP VXLAN en mode STATIQUE =====
# Miroir de routeur_apintus-1 : seules les IP changent (10.1.1.2 / remote 10.1.1.1).
# Cablage GNS3 : eth0 -> host   |   eth1 -> Switch_apintus (underlay)

# --- Underlay : reseau de transport entre les 2 routeurs (via Switch_apintus) ---
ip addr add 10.1.1.2/24 dev eth1      # IP underlay de CE VTEP (face au switch)
ip link set eth1 up

# --- Interface VXLAN ---
# remote pointe vers l'autre VTEP (routeur_apintus-1)
ip link add vxlan10 type vxlan id 10 dev eth1 remote 10.1.1.1 dstport 4789

# --- Bridge br0 : pont L2 entre le host (eth0) et le tunnel (vxlan10) ---
ip link add br0 type bridge
ip link set vxlan10 master br0
ip link set eth0 master br0

# --- Activation de toutes les interfaces ---
ip link set vxlan10 up
ip link set eth0 up
ip link set br0 up

# Verification :
#   ip -d link show vxlan10   -> affiche le VNI 10 et le remote 10.1.1.1
#   bridge fdb show
