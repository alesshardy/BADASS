#!/bin/sh
# ===== routeur_apintus-1 : VTEP VXLAN en mode MULTICAST dynamique =====
# Difference avec le mode statique : au lieu de designer l'autre VTEP par son
# IP (remote), tous les VTEP rejoignent un GROUPE multicast. Le trafic BUM
# (Broadcast, Unknown-unicast, Multicast) est diffuse via ce groupe, ce qui
# permet la decouverte DYNAMIQUE des VTEP et l'apprentissage des MAC.
# Cablage GNS3 : eth0 -> host   |   eth1 -> Switch_apintus (underlay)

# --- Underlay : reseau de transport entre les 2 routeurs (via Switch_apintus) ---
ip addr add 10.1.1.1/24 dev eth1
ip link set eth1 up

# --- Interface VXLAN ---
# group 239.1.1.1 : groupe multicast partage par tous les VTEP (modifiable)
# dev eth1        : interface underlay (face au switch)
ip link add vxlan10 type vxlan id 10 dev eth1 group 239.1.1.1 dstport 4789

# --- Bridge br0 : pont L2 entre le host (eth0) et le tunnel (vxlan10) ---
ip link add br0 type bridge
ip link set vxlan10 master br0
ip link set eth0 master br0

# --- Activation de toutes les interfaces ---
ip link set vxlan10 up
ip link set eth0 up
ip link set br0 up

# Verification :
#   ip -d link show vxlan10   -> doit afficher "group 239.1.1.1"
#   brctl showmacs br0        -> table des MAC apprises (cf. sujet)
